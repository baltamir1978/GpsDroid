<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Grabar un track con la pantalla apagada: servicio en primer plano de tipo «location».
         No hace falta ACCESS_BACKGROUND_LOCATION porque se arranca con la app delante. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Un toque corto al volver al track que se sigue. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Pedir que no se optimice la batería (para que el GPS no se espacie con la pantalla apagada
         mientras se graba). Google Play lo restringe; esta app no va a Google Play. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Android Auto: app de navegación (la única categoría que puede pintar su propio mapa). -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />


    <application
        android:name=".GpsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gps">

        <activity android:name=".ui.MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".data.TrackService" android:exported="false" android:foregroundServiceType="location" />
        <!-- Seguir un track: avisa al salirse con la pantalla apagada. -->
        <service android:name=".data.FollowService" android:exported="false" android:foregroundServiceType="location" />

        <!-- Android Auto. Ojo: «Fuentes desconocidas» de Android Auto NO basta para las apps de la
             Car App Library (las trata como TEMPLATE): sólo salen si Google Play las avala. Ver CLAUDE.md. -->
        <!-- Sin permiso a propósito: quien se conecta lo filtra el HostValidator (sólo anfitriones conocidos). -->
        <service android:name=".car.GpsCarAppService" android:exported="true" tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <!-- El mapa también en el cuadro de instrumentos (ClusterCarScreen), si el coche lo tiene. -->
                <category android:name="androidx.car.app.category.FEATURE_CLUSTER" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <!-- 2: la barra de acciones del mapa, arrastrar y pellizcar. -->
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="2" />

        <!-- «Compartir GPX» -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/paths" />
        </provider>
    </application>
</manifest>
